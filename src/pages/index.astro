---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Ticker from '../components/Ticker.astro';
import Story from '../components/Story.astro';
import Shop from '../components/Shop.astro';
import Visit from '../components/Visit.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site.js';

// The Shopify layer is ready whenever you build the shop/menu page.
// Example (works today with mocks, later with the real store):
// import { getProducts } from '../lib/shopify.js';
// const products = await getProducts();
---

<Base
  title={`${site.name} — ${site.tagline}`}
  description="Slow-roasted specialty coffee. We take our time so you can take yours."
>
  <div class="hero-stage">
    <div class="above-fold">
      <Header />
      <Hero />
      <Ticker />
    </div>
    <main>
      <Visit />
      <Story />
      <Shop />
    </main>
  </div>
  <Footer />
</Base>

<style>
  .hero-stage {
    position: relative;
  }

  /* Hero grows to fill whatever room is left after the Header + Ticker's
     natural height, so the ticker band lands at the foot of the
     first viewport on load instead of wherever the image happens
     to end. */
  .above-fold {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .above-fold :global(.hero) {
    flex: 1;
  }
</style>
