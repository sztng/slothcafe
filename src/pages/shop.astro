---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site.js';
import { getProducts } from '../lib/shopify.js';

const products = await getProducts();
---

<Base
  title={`Shop — ${site.name}`}
  description="All our specialty coffee, roasted weekly."
>
  <Header />
  <main>
    <section class="shop">
      <div class="container">
        <h1 class="shop__title">OUR BEANS, RIGHT TO YOUR DOORSTEP</h1>

        <div class="products">
          {
            products.map((product) => (
              <article class="product">
                <img
                  src={product.featuredImage.url}
                  alt={product.featuredImage.altText}
                  class="product__img"
                />
                <h3 class="product__name">{product.title}</h3>
                <p class="product__notes">tasting notes: {product.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .shop {
    padding-block: 3rem var(--section-pad);
  }

  .shop__title {
    font-family: var(--font-body);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-align: center;
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin: 0 0 3rem;
  }

  .products {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
  }

  .product {
    text-align: center;
  }

  .product__img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: contain;
    margin-bottom: 1.25rem;
  }

  .product__name {
    font-family: var(--font-body);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-size: 1.05rem;
    margin: 0 0 0.5rem;
  }

  .product__notes {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: rgba(0, 0, 0, 0.65);
    margin: 0;
  }

  @media (max-width: 700px) {
    .products {
      grid-template-columns: 1fr;
    }
  }
</style>
