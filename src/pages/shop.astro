---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site.js';
import { getProducts } from '../lib/shopify.js';

const products = await getProducts();
---

<Base
  title={`Shop — ${site.name}`}
  description="All our specialty coffee, roasted weekly."
>
  <Header />
  <main>
    <section class="shop-banner">
      <img src="/images/coffeeBeans.jpg" alt="" class="shop-banner__img" />
      <h1 class="shop-banner__title" data-reveal="shop-banner-title">
        Our beans, right to your doorstep
      </h1>
    </section>

    <section class="shop">
      <div class="container">
        <div class="products">
          {
            products.map((product) => {
              const variant = product.variants.nodes[0];
              return (
                <article class="product" data-reveal="product-cards">
                  <img
                    src={product.featuredImage.url}
                    alt={product.featuredImage.altText}
                    class="product__img"
                  />
                  <h3 class="product__name">{product.title}</h3>
                  <p class="product__notes">tasting notes: {product.description}</p>
                  {variant && (
                    <p class="product__price">
                      {variant.price.currencyCode} {variant.price.amount}
                    </p>
                  )}
                  {variant?.availableForSale ? (
                    <button
                      type="button"
                      class="product__add"
                      data-add-to-cart
                      data-variant-id={variant.id}
                      data-title={product.title}
                      data-price-amount={variant.price.amount}
                      data-price-currency={variant.price.currencyCode}
                      data-image={product.featuredImage.url}
                    >
                      Add to cart
                    </button>
                  ) : (
                    <span class="product__soldout">Sold out</span>
                  )}
                </article>
              );
            })
          }
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<script>
  import { addToCart } from '../lib/cart.js';

  document.querySelectorAll('[data-add-to-cart]').forEach((btn) => {
    btn.addEventListener('click', () => {
      addToCart({
        variantId: btn.dataset.variantId,
        title: btn.dataset.title,
        priceAmount: btn.dataset.priceAmount,
        priceCurrency: btn.dataset.priceCurrency,
        image: btn.dataset.image,
        quantity: 1,
      });
    });
  });
</script>

<style>
  .shop-banner {
    position: relative;
    overflow: hidden;
  }

  .shop-banner__img {
    display: block;
    width: 100%;
    height: clamp(400px, 42vw, 560px);
    object-fit: cover;
    object-position: center 40%;
  }

  .shop-banner::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.65), rgba(0, 0, 0, 0) 65%);
    pointer-events: none;
  }

  .shop-banner__title {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    margin: 0;
    padding: 1.5rem clamp(1.25rem, 4vw, 3rem);
    color: var(--white);
    font-family: var(--font-body);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-size: clamp(1.25rem, 3vw, 2rem);
  }

  .shop {
    padding-block: 3rem var(--section-pad);
  }

  .products {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
  }

  .product {
    text-align: center;
  }

  .product__img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: contain;
    margin-bottom: 1.25rem;
  }

  .product__name {
    font-family: var(--font-body);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-size: 1.05rem;
    margin: 0 0 0.5rem;
  }

  .product__notes {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: rgba(0, 0, 0, 0.65);
    margin: 0 0 0.75rem;
  }

  .product__price {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.9rem;
    margin: 0 0 0.75rem;
  }

  .product__add {
    display: inline-block;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    font-family: var(--font-mono);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.8rem;
    color: #000;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .product__add:hover {
    color: var(--teal-deep);
  }

  .product__soldout {
    display: inline-block;
    font-family: var(--font-mono);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.8rem;
    color: rgba(0, 0, 0, 0.4);
  }

  @media (max-width: 700px) {
    .products {
      grid-template-columns: 1fr;
    }
  }
</style>
