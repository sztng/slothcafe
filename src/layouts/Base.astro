---
import '@fontsource/playfair-display/500.css';
import '@fontsource/playfair-display/700.css';
import '@fontsource/playfair-display/500-italic.css';
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fortawesome/fontawesome-free/css/all.min.css';
import '../styles/global.css';
import { SHOPIFY_DOMAIN, STOREFRONT_TOKEN } from '../lib/shopify.js';

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/images/logoSmallText.png" type="image/png" />
    <script is:inline>
      // Marks that JS is running so CSS can safely hide [data-reveal]
      // elements for GSAP. No JS → class never added → nothing hidden.
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body data-shopify-domain={SHOPIFY_DOMAIN} data-shopify-token={STOREFRONT_TOKEN}>
    <slot />

    <script>
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      const reduceMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches;

      if (!reduceMotion) {
        /* ---- Hero: one orchestrated load sequence ---- */
        gsap
          .timeline({ defaults: { ease: 'power3.out' } })
          .to('[data-reveal="hero-eyebrow"]', { opacity: 1, y: 0, duration: 0.3 })
          .to(
            '[data-reveal="hero-line"]',
            { opacity: 1, y: 0, duration: 0.5, stagger: 0.08 },
            '-=0.15'
          )
          .to(
            '[data-reveal="hero-actions"]',
            { opacity: 1, y: 0, duration: 0.35 },
            '-=0.25'
          )
          .to(
            '[data-reveal="hero-special"]',
            { opacity: 1, y: 0, duration: 0.4 },
            '-=0.2'
          )
          .to(
            '[data-reveal="visit-item"]',
            { opacity: 1, y: 0, duration: 0.4, stagger: 0.08 },
            '-=0.2'
          );

        gsap.set(
          '[data-reveal="hero-eyebrow"], [data-reveal="hero-line"], [data-reveal="hero-actions"], [data-reveal="hero-special"], [data-reveal="visit-item"]',
          { y: 16 }
        );

        /* ---- Sections: quiet scroll-in, once ---- */
        document.querySelectorAll('[data-reveal="scroll"]').forEach((el) => {
          gsap.fromTo(
            el,
            { opacity: 0, y: 32 },
            {
              opacity: 1,
              y: 0,
              duration: 0.8,
              ease: 'power3.out',
              scrollTrigger: { trigger: el, start: 'top 82%', once: true },
            }
          );
        });

        /* ---- Visit cards: staggered reveal on scroll ---- */
        const visitCards = document.querySelectorAll('[data-reveal="visit-cards"]');
        if (visitCards.length) {
          gsap.fromTo(
            visitCards,
            { opacity: 0, y: 32 },
            {
              opacity: 1,
              y: 0,
              duration: 0.7,
              ease: 'power3.out',
              stagger: 0.15,
              scrollTrigger: { trigger: '.cards', start: 'top 82%', once: true },
            }
          );
        }

        /* ---- Shop banner title: fades in on load (it's above the
           fold, so a scroll trigger would fire inconsistently) ---- */
        gsap.fromTo(
          '[data-reveal="shop-banner-title"]',
          { opacity: 0, y: 24 },
          { opacity: 1, y: 0, duration: 0.7, ease: 'power3.out', delay: 0.15 }
        );

        /* ---- Product cards: staggered reveal on scroll ---- */
        const productCards = document.querySelectorAll('[data-reveal="product-cards"]');
        if (productCards.length) {
          gsap.fromTo(
            productCards,
            { opacity: 0, y: 32 },
            {
              opacity: 1,
              y: 0,
              duration: 0.7,
              ease: 'power3.out',
              stagger: 0.12,
              scrollTrigger: { trigger: '.products', start: 'top 85%', once: true },
            }
          );
        }

        /* ---- Ticker: handled purely by CSS ---- */

        /* ---- Story stats: count up when they enter view ---- */
        document.querySelectorAll('[data-count]').forEach((el) => {
          const target = Number(el.getAttribute('data-count'));
          const suffix = el.getAttribute('data-count-suffix') ?? '';
          const obj = { n: 0 };
          gsap.to(obj, {
            n: target,
            duration: 1.4,
            ease: 'power2.out',
            scrollTrigger: { trigger: el, start: 'top 85%', once: true },
            onUpdate: () => {
              el.textContent = Math.round(obj.n) + suffix;
            },
          });
        });
      } else {
        // Reduced motion: show everything immediately.
        gsap.set('[data-reveal]', { opacity: 1 });
      }
    </script>
  </body>
</html>
