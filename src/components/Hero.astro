---
import { site } from '../data/site.js';
const { hero } = site;
---

<section class="hero">
  <div class="hero__inner">
    <div class="hero__copy">
      <p class="hero__eyebrow" data-reveal="hero-eyebrow">{hero.eyebrow}</p>
      <h1 class="hero__title">
        {hero.headline.map((line) => (
          <span class="hero__line" data-reveal="hero-line">
            {line}
          </span>
        ))}
      </h1>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    color: #ffffff;
    background: url('/images/storeFront.jpg');
    background-size: cover;
    background-position: center 45%;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .hero__inner {
    padding-block: 0 clamp(3rem, 8vw, 6rem);
    padding-inline: clamp(1.25rem, 4vw, 3rem);
  }

  .hero__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.35em;
    margin: 0 0 1rem;
  }

  .hero__title {
    font-size: clamp(2.5rem, 5.5vw, 7rem);
    font-weight: 600;
    line-height: 1;
    max-width: 100%;
    overflow-wrap: break-word;
  }

  .hero__line {
    display: block;
  }

  .hero__actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>