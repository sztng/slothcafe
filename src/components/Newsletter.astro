---
import { site } from '../data/site.js';
const { newsletter } = site;
---

<div class="newsletter">
  <div class="container newsletter__inner" data-reveal="scroll">
    <div>
      <h3 class="newsletter__title">{newsletter.headline}</h3>
      <p class="newsletter__sub">{newsletter.sub}</p>
    </div>

    <form class="newsletter__form" onsubmit="event.preventDefault()">
      <input
        type="email"
        required
        placeholder={newsletter.placeholder}
        aria-label={newsletter.placeholder}
        class="newsletter__input"
      />
      <button type="submit" class="newsletter__btn">{newsletter.cta}</button>
    </form>
  </div>
</div>

<style>
  .newsletter {
    margin-top: var(--section-pad);
  }

  .newsletter__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
  }

  .newsletter__title {
    font-family: var(--font-body);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-size: 1.3rem;
    margin: 0 0 0.75rem;
  }

  .newsletter__sub {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: rgba(0, 0, 0, 0.7);
    max-width: 34ch;
    margin: 0;
  }

  .newsletter__form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: min(320px, 100%);
  }

  .newsletter__input {
    font-family: var(--font-mono);
    text-transform: uppercase;
    font-size: 0.85rem;
    padding: 0.9em 1.1em;
    border: 1px solid rgba(20, 51, 45, 0.15);
    border-radius: 8px;
    background: var(--white);
    color: #000;
  }

  .newsletter__input::placeholder {
    color: rgba(0, 0, 0, 0.4);
  }

  .newsletter__btn {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 700;
    font-size: 0.85rem;
    padding: 0.9em 1.1em;
    border: none;
    border-radius: 8px;
    background: var(--mint);
    color: #000;
    cursor: pointer;
    transition: background-color 160ms ease;
  }

  .newsletter__btn:hover {
    background: var(--teal);
    color: var(--white);
  }

  @media (max-width: 700px) {
    .newsletter__inner {
      align-items: flex-start;
    }
  }
</style>
