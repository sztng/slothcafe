---
import { site } from '../data/site.js';
const { newsletter } = site;
---

<div class="newsletter">
  <div class="container newsletter__inner" data-reveal="scroll">
    <div>
      <h3 class="newsletter__title">{newsletter.headline}</h3>
      <p class="newsletter__sub">{newsletter.sub}</p>
    </div>

    <form class="newsletter__form" data-newsletter-form>
      <input
        type="email"
        required
        placeholder={newsletter.placeholder}
        aria-label={newsletter.placeholder}
        class="newsletter__input"
        data-newsletter-input
      />
      <button type="submit" class="newsletter__btn" data-newsletter-btn>{newsletter.cta}</button>
      <p class="newsletter__status" data-newsletter-status role="status" aria-live="polite" hidden></p>
    </form>
  </div>
</div>

<script>
  import { subscribeToNewsletter } from '../lib/newsletter.js';

  const form = document.querySelector('[data-newsletter-form]');
  const input = form.querySelector('[data-newsletter-input]');
  const button = form.querySelector('[data-newsletter-btn]');
  const status = form.querySelector('[data-newsletter-status]');
  const domain = document.body.dataset.shopifyDomain;
  const token = document.body.dataset.shopifyToken;

  function setStatus(message, state) {
    status.textContent = message;
    status.dataset.state = state;
    status.hidden = false;
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = input.value.trim();
    if (!email) return;

    button.disabled = true;
    const originalLabel = button.textContent;
    button.textContent = 'Subscribing…';

    try {
      const { alreadySubscribed } = await subscribeToNewsletter({ domain, token, email });
      setStatus(
        alreadySubscribed ? "You're already on the list!" : 'Subscribed — welcome!',
        'success'
      );
      input.value = '';
    } catch {
      setStatus('Something went wrong — please try again.', 'error');
    } finally {
      button.disabled = false;
      button.textContent = originalLabel;
    }
  });
</script>

<style>
  .newsletter {
    margin-top: var(--section-pad);
    padding-bottom: var(--section-pad);
  }

  .newsletter__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
  }

  .newsletter__title {
    font-family: var(--font-body);
    font-weight: 700;
    letter-spacing: 0.03em;
    font-size: 1.3rem;
    margin: 0 0 0.75rem;
  }

  .newsletter__sub {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: rgba(0, 0, 0, 0.7);
    max-width: 34ch;
    margin: 0;
  }

  .newsletter__form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: min(320px, 100%);
  }

  .newsletter__input {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    padding: 0.9em 1.1em;
    border: 1px solid rgba(20, 51, 45, 0.15);
    border-radius: 8px;
    background: var(--white);
    color: #000;
  }

  .newsletter__input::placeholder {
    color: rgba(0, 0, 0, 0.4);
  }

  .newsletter__btn {
    font-family: var(--font-mono);
    letter-spacing: 0.05em;
    font-weight: 700;
    font-size: 0.85rem;
    padding: 0.9em 1.1em;
    border: none;
    border-radius: 8px;
    background: var(--mint);
    color: #000;
    cursor: pointer;
    transition: background-color 160ms ease;
  }

  .newsletter__btn:hover {
    background: var(--teal);
    color: var(--white);
  }

  .newsletter__btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .newsletter__status {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    margin: 0;
  }

  .newsletter__status[data-state='success'] {
    color: var(--teal-deep);
  }

  .newsletter__status[data-state='error'] {
    color: #b3261e;
  }

  @media (max-width: 700px) {
    .newsletter__inner {
      align-items: flex-start;
    }
  }
</style>
