---
import { site } from '../data/site.js';
---

<footer class="footer">
  <div class="container footer__inner">
    <p class="footer__copyright">{site.footer.copyright}</p>

    <img src="/images/logoBigText.png" alt={site.name} class="footer__logo" />

    <div class="footer__contact">
      <p>{site.visit.email}</p>
      <p>instagram | {site.visit.instagram}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--ink);
    color: #000;
    padding-block: 2rem;
  }

  .footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .footer__logo {
    height: 80px;
    width: auto;
  }

  .footer__copyright {
    color: rgba(0, 0, 0, 0.6);
    font-size: 0.9rem;
    margin: 0;
  }

  .footer__contact {
    text-align: right;
  }

  .footer__contact p {
    color: rgba(0, 0, 0, 0.6);
    font-size: 0.9rem;
    margin: 0;
  }
</style>
