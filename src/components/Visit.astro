---
import { site } from '../data/site.js';
const { visit } = site;
---

<section class="visit" id="visit">
  <div class="container info">
    <div class="info__item" data-reveal="scroll">
      <h3 class="info__title">Location</h3>
      <p class="info__line">{visit.location}</p>
    </div>

    <div class="info__item" data-reveal="scroll">
      <h3 class="info__title">Hours</h3>
      <p class="info__line">{visit.hours}</p>
    </div>

    <div class="info__item" data-reveal="scroll">
      <h3 class="info__title">Reach out</h3>
      <p class="info__line">{visit.email}</p>
      <p class="info__line">Instagram | {visit.instagram}</p>
    </div>
  </div>
</section>

<style>
  .visit {
    background: var(--paper);
    padding-block: 3rem;
  }

  .info {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    text-align: center;
  }

  .info__title {
    font-family: var(--font-body);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-size: 1.1rem;
    margin: 0 0 0.6rem;
  }

  .info__line {
    font-size: 0.95rem;
    color: rgba(0, 0, 0, 0.8);
    margin: 0;
  }

  @media (max-width: 700px) {
    .info {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
  }
</style>
