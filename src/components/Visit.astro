---
import { site } from '../data/site.js';
const { visit } = site;
---

<section class="visit" id="visit">
  <div class="container">
    <p class="eyebrow" data-reveal="scroll">{visit.eyebrow}</p>
    <h2 class="visit__title" data-reveal="scroll">{visit.headline}</h2>

    <div class="cards">
      <article class="card" data-reveal="visit-cards">
        <h3 class="card__title">
          <svg class="card__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2" />
            <path d="M12 7v5l3.5 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
          Hours
        </h3>
        <dl class="hours">
          {
            visit.hours.rows.map((row) => (
              <div class="hours__row">
                <dt>{row.days}</dt>
                <dd>{row.time}</dd>
              </div>
            ))
          }
        </dl>
        <p class="card__note">{visit.hours.note}</p>
      </article>

      <article class="card" data-reveal="visit-cards">
        <h3 class="card__title">
          <svg class="card__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M12 21s7-5.1 7-11a7 7 0 1 0-14 0c0 5.9 7 11 7 11Z"
              stroke="currentColor"
              stroke-width="2"
            />
            <circle cx="12" cy="10" r="2.5" stroke="currentColor" stroke-width="2" />
          </svg>
          Location
        </h3>
        <p class="card__lines">
          {visit.location.lines.map((line) => <span>{line}</span>)}
        </p>
        <p class="card__note">{visit.location.note}</p>
        <a class="card__link" href={visit.location.directionsUrl}>Get directions →</a>
      </article>
    </div>
  </div>
</section>

<style>
  .visit {
    background: var(--white);
    padding-top: 3rem;
  }

  .visit__title {
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    font-weight: 700;
    margin-bottom: 3rem;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .card {
    background: var(--mint-card);
    border-radius: var(--radius-card);
    padding: 2.25rem;
  }

  .card__title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.35rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
  }

  .card__icon {
    width: 1.15em;
    height: 1.15em;
    color: var(--teal);
    flex-shrink: 0;
  }

  .hours {
    margin: 0;
  }

  .hours__row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.6rem;
  }

  .hours__row dt {
    color: rgba(20, 51, 45, 0.75);
  }

  .hours__row dd {
    margin: 0;
    font-weight: 500;
  }

  .card__note {
    color: rgba(20, 51, 45, 0.65);
    font-size: 0.95rem;
    margin: 1.5rem 0 0;
  }

  .card__lines span {
    display: block;
  }

  .card__link {
    display: inline-block;
    margin-top: 1.25rem;
    font-weight: 500;
    text-decoration: none;
  }

  .card__link:hover {
    text-decoration: underline;
  }

  @media (max-width: 900px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
