---
import { site } from '../data/site.js';
import Logo from './Logo.astro';
---

<header class="header">
  <div class="container header__inner">
    <nav class="nav" aria-label="Main">
      {site.nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <a href="/" class="brand" aria-label={`${site.name} — home`}>
      <Logo size={200} src="/images/logoName.png" ratio={116 / 578} />
    </a>

    <a href={site.cta.href} class="btn btn--solid nav__cta" aria-label={site.cta.label}>
      <i class="fa-solid fa-cart-shopping"></i>
    </a>
  </div>
</header>

<style>
  .header {
    background: var(--paper);
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid rgba(20, 51, 45, 0.06);
  }

  .header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding-block: 0.9rem;
  }

  .brand {
    display: flex;
    justify-self: center;
    text-decoration: none;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2.5rem);
  }

  .nav a {
    color: var(--ink);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
  }

  .nav a:hover {
    color: var(--teal);
  }

  .nav__cta {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.75em;
    font-size: 1.1rem;
    background: var(--paper);
    color: var(--teal);
  }

  @media (max-width: 640px) {
    .nav a {
      display: none; /* keep it simple on mobile: logo + CTA */
    }
  }
</style>
