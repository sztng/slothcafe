---
import { site } from '../data/site.js';
---

<header class="header">
  <div class="container header__inner">
    <a href="/" class="brand" aria-label={`${site.name} — home`}>
      <img src="/images/logoSmallText.png" alt="" class="brand__img" />
    </a>

    <nav class="nav" aria-label="Main">
      {site.nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
  </div>
</header>

<style>
  .header {
    background: var(--paper);
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid rgba(20, 51, 45, 0.06);
  }

  .header__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block: 1.75rem 1.25rem;
  }

  .brand {
    display: flex;
    text-decoration: none;
    margin-bottom: 1.5rem;
  }

  .brand__img {
    width: 110px;
    height: auto;
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(1.5rem, 4vw, 4rem);
  }

  .nav a {
    font-family: var(--font-body);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: #000;
    text-decoration: none;
    font-size: 1rem;
  }

  .nav a:hover {
    color: var(--teal);
  }

  @media (max-width: 640px) {
    .nav a {
      display: none; /* keep it simple on mobile: logo only */
    }
  }
</style>
