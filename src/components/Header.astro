---
import { site } from '../data/site.js';
import Logo from './Logo.astro';
---

<header class="header">
  <div class="container header__inner">
    <a href="/" class="brand" aria-label={`${site.name} — home`}>
      <Logo size={170} />
    </a>

    <div class="navrow">
      <span class="navrow__spacer" aria-hidden="true"></span>

      <nav class="nav" aria-label="Main">
        {site.nav.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>

      <a href={site.cta.href} class="btn btn--solid nav__cta" aria-label={site.cta.label}>
        <i class="fa-solid fa-cart-shopping"></i>
      </a>
    </div>
  </div>
</header>

<style>
  .header {
    background: var(--paper);
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid rgba(20, 51, 45, 0.06);
  }

  .header__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block: 1.5rem 1.1rem;
  }

  .brand {
    display: flex;
    text-decoration: none;
    margin-bottom: 1.25rem;
  }

  .navrow {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    width: 100%;
  }

  .navrow__spacer {
    display: block;
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .nav a {
    font-family: 'Futura', 'Century Gothic', var(--font-body), sans-serif;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--ink);
    text-decoration: none;
    font-size: 1rem;
  }

  .nav a:hover {
    color: var(--teal);
  }

  .nav__cta {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.6em;
    font-size: 1.1rem;
    background: var(--paper);
    color: var(--ink);
  }

  @media (max-width: 640px) {
    .nav a {
      display: none; /* keep it simple on mobile: logo + CTA */
    }
  }
</style>
