---
import { site } from '../data/site.js';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="header">
  <div class="header__inner">
    <a href="/" class="brand" aria-label={`${site.name} — home`}>
      <img src="/images/logoSmallText.png" alt="" class="brand__img" />
    </a>

    <nav class="nav" aria-label="Main" data-nav>
      <button
        type="button"
        class="nav__toggle"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="nav-links"
        data-nav-toggle
      >
        <i class="fa-solid fa-bars" aria-hidden="true"></i>
      </button>

      <div class="nav__links" id="nav-links">
        {site.nav.map((item) => (
          <a href={item.href} class={item.href === currentPath ? 'active' : ''}>
            {item.label}
          </a>
        ))}
      </div>

      <div class="cart" data-cart>
        <button
          class="cart__toggle"
          type="button"
          aria-label="Cart"
          aria-expanded="false"
          data-cart-toggle
        >
          <i class="fa-solid fa-cart-shopping nav__cart" aria-hidden="true"></i>
          <span class="cart__badge" data-cart-badge hidden>0</span>
        </button>

        <div class="cart__panel" data-cart-panel hidden>
          <p class="cart__empty" data-cart-empty>Your Cart is Empty</p>
          <ul class="cart__items" data-cart-items></ul>
          <div class="cart__footer" data-cart-footer hidden>
            <div class="cart__subtotal">
              <span>Subtotal</span>
              <span data-cart-subtotal></span>
            </div>
            <a class="cart__checkout" data-cart-checkout href="#">Checkout</a>
          </div>
        </div>
      </div>
    </nav>
  </div>
</header>

<script>
  import {
    getCart,
    setQuantity,
    removeFromCart,
    getCartCount,
    buildCheckoutUrl,
  } from '../lib/cart.js';

  const navRoot = document.querySelector('[data-nav]');
  const navToggle = navRoot.querySelector('[data-nav-toggle]');

  function closeNav() {
    navRoot.removeAttribute('data-open');
    navToggle.setAttribute('aria-expanded', 'false');
  }

  function openNav() {
    navRoot.setAttribute('data-open', '');
    navToggle.setAttribute('aria-expanded', 'true');
  }

  navToggle.addEventListener('click', () => {
    if (navRoot.hasAttribute('data-open')) closeNav();
    else openNav();
  });

  document.addEventListener('click', (e) => {
    if (!e.composedPath().includes(navRoot)) closeNav();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeNav();
  });

  const root = document.querySelector('[data-cart]');
  const toggle = root.querySelector('[data-cart-toggle]');
  const panel = root.querySelector('[data-cart-panel]');
  const badge = root.querySelector('[data-cart-badge]');
  const itemsEl = root.querySelector('[data-cart-items]');
  const emptyEl = root.querySelector('[data-cart-empty]');
  const footerEl = root.querySelector('[data-cart-footer]');
  const subtotalEl = root.querySelector('[data-cart-subtotal]');
  const checkoutLink = root.querySelector('[data-cart-checkout]');
  const domain = document.body.dataset.shopifyDomain;

  function formatMoney(amount, currencyCode) {
    return `${currencyCode} ${amount.toFixed(2)}`;
  }

  function render() {
    const items = getCart();
    const count = getCartCount();

    badge.textContent = String(count);
    badge.hidden = count === 0;

    emptyEl.hidden = items.length > 0;
    footerEl.hidden = items.length === 0;

    itemsEl.replaceChildren();

    let subtotal = 0;
    let currencyCode = '';

    for (const item of items) {
      currencyCode = item.priceCurrency;
      subtotal += Number(item.priceAmount) * item.quantity;

      const li = document.createElement('li');
      li.className = 'cart__item';

      const img = document.createElement('img');
      img.className = 'cart__item-img';
      img.src = item.image;
      img.alt = '';

      const info = document.createElement('div');
      info.className = 'cart__item-info';

      const title = document.createElement('p');
      title.className = 'cart__item-title';
      title.textContent = item.title;

      const price = document.createElement('p');
      price.className = 'cart__item-price';
      price.textContent = formatMoney(Number(item.priceAmount), item.priceCurrency);

      const qtyRow = document.createElement('div');
      qtyRow.className = 'cart__item-qty';

      const minus = document.createElement('button');
      minus.type = 'button';
      minus.textContent = '−';
      minus.setAttribute('aria-label', `Decrease quantity of ${item.title}`);
      minus.addEventListener('click', () => setQuantity(item.variantId, item.quantity - 1));

      const qty = document.createElement('span');
      qty.textContent = String(item.quantity);

      const plus = document.createElement('button');
      plus.type = 'button';
      plus.textContent = '+';
      plus.setAttribute('aria-label', `Increase quantity of ${item.title}`);
      plus.addEventListener('click', () => setQuantity(item.variantId, item.quantity + 1));

      const remove = document.createElement('button');
      remove.type = 'button';
      remove.className = 'cart__item-remove';
      remove.textContent = 'Remove';
      remove.addEventListener('click', () => removeFromCart(item.variantId));

      qtyRow.append(minus, qty, plus);
      info.append(title, price, qtyRow, remove);
      li.append(img, info);
      itemsEl.append(li);
    }

    subtotalEl.textContent = items.length ? formatMoney(subtotal, currencyCode) : '';
    checkoutLink.href = items.length ? buildCheckoutUrl(domain) : '#';
  }

  function openPanel() {
    panel.hidden = false;
    toggle.setAttribute('aria-expanded', 'true');
  }

  function closePanel() {
    panel.hidden = true;
    toggle.setAttribute('aria-expanded', 'false');
  }

  toggle.addEventListener('click', () => {
    if (panel.hidden) openPanel();
    else closePanel();
  });

  document.addEventListener('click', (e) => {
    if (!e.composedPath().includes(root)) closePanel();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closePanel();
  });

  window.addEventListener('cart:change', render);

  render();
</script>

<style>
  .header {
    background: var(--paper);
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid rgba(20, 51, 45, 0.06);
    transition: background-color 250ms ease, border-color 250ms ease;
  }

  .header__inner {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    min-height: 100px;
    padding-block: 1.5rem;
    padding-inline: clamp(1rem, 3vw, 2rem);
  }

  .brand {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    text-decoration: none;
  }

  .brand__img {
    width: 84px;
    height: auto;
  }

  .nav {
    display: flex;
    align-items: center;
    width: 100%;
    justify-content: space-between;
    gap: clamp(1.5rem, 4vw, 4rem);
    margin-top: 1.15rem;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
  }

  .nav a {
    font-family: var(--font-body);
    font-weight: 500;
    letter-spacing: 0.02em;
    color: #000;
    text-decoration: none;
    font-size: calc(0.8rem + 2px);
    transition: color 250ms ease;
  }

  .nav a:hover {
    color: var(--teal);
  }

  .nav a.active {
    color: var(--ink);
  }

  .nav__cart {
    font-size: 1.3rem;
    color: #000;
    transition: color 250ms ease;
  }

  .nav__toggle {
    display: none;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    font-size: 1.2rem;
    line-height: 1;
    color: #000;
  }

  .cart {
    position: relative;
  }

  .cart__toggle {
    position: relative;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    display: flex;
    align-items: center;
  }

  .cart__badge {
    position: absolute;
    top: -0.5rem;
    right: -0.7rem;
    background: var(--teal);
    color: var(--white);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
    line-height: 1;
    padding: 0.25rem 0.4rem;
    border-radius: var(--radius-pill);
    min-width: 1.1rem;
    text-align: center;
  }

  .cart__panel {
    position: absolute;
    top: calc(100% + 1rem);
    right: 0;
    width: min(300px, calc(100vw - 2rem));
    background: var(--paper);
    border: 1px solid rgba(20, 51, 45, 0.1);
    border-radius: var(--radius-card);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12);
    padding: 1.25rem;
    z-index: 20;
  }

  .cart__empty {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: rgba(0, 0, 0, 0.55);
    text-align: center;
    margin: 0;
  }

  .cart__items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-height: 320px;
    overflow-y: auto;
  }

  .cart__footer {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(20, 51, 45, 0.1);
  }

  .cart__subtotal {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.85rem;
    margin-bottom: 0.9rem;
  }

  .cart__checkout {
    display: block;
    text-align: center;
    background: var(--teal);
    color: var(--white);
    font-family: var(--font-mono);
    font-weight: 700;
    letter-spacing: 0.08em;
    font-size: 0.8rem;
    padding: 0.75rem;
    border-radius: var(--radius-pill);
    text-decoration: none;
  }

  .cart__checkout:hover {
    background: var(--teal-deep);
  }

  @media (max-width: 640px) {
    .nav__toggle {
      display: inline-flex;
    }

    .nav__links {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: center;
      gap: 1.5rem;
      background: var(--paper);
      padding: 1.5rem 1rem;
      border-bottom: 1px solid rgba(20, 51, 45, 0.06);
      box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08);
    }

    .nav[data-open] .nav__links {
      display: flex;
    }
  }
</style>

<style is:global>
  /* Cart line items are built with document.createElement in the script
     below, so Astro's scoped-style attribute never lands on them —
     these rules have to be global to reach them. */
  .cart__item {
    display: flex;
    gap: 0.75rem;
  }

  .cart__item-img {
    width: 56px;
    height: 56px;
    object-fit: contain;
    background: var(--mint-card);
    border-radius: 8px;
    flex-shrink: 0;
  }

  .cart__item-info {
    flex: 1;
    min-width: 0;
  }

  .cart__item-title {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.85rem;
    margin: 0 0 0.15rem;
  }

  .cart__item-price {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: rgba(0, 0, 0, 0.6);
    margin: 0 0 0.4rem;
  }

  .cart__item-qty {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    margin-bottom: 0.3rem;
  }

  .cart__item-qty button {
    width: 1.4rem;
    height: 1.4rem;
    border: 1px solid rgba(0, 0, 0, 0.2);
    background: none;
    border-radius: 4px;
    cursor: pointer;
    line-height: 1;
  }

  .cart__item-remove {
    background: none;
    border: none;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-decoration: underline;
    color: rgba(0, 0, 0, 0.5);
    cursor: pointer;
  }
</style>
