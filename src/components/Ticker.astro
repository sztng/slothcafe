---
import { site } from '../data/site.js';
// Duplicate the phrase list so the GSAP loop (translate to -50%) is seamless.
const phrases = [...site.ticker, ...site.ticker, ...site.ticker, ...site.ticker, ...site.ticker, ...site.ticker];
---

<div class="ticker" aria-hidden="true">
  <div class="ticker__track" data-ticker-track>
    {
      phrases.map((phrase) => (
        <>
          <span class="ticker__item">
            {phrase}
          </span>
          <span class="ticker__dot">•</span>
        </>
      ))
    }
  </div>
</div>

<style>
  .ticker {
    background: var(--ink);
    color: #000;
    overflow: hidden;
    padding-block: 0.75rem;
  }

  .ticker__track {
    display: flex;
    width: max-content;
    white-space: nowrap;
  }

  .ticker__item {
    font-family: var(--font-jetbrainsmono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1;
    padding-inline: 0.9rem;
    align-content: center;
  }

  .ticker__dot {
    margin-left: 0.95rem;
    margin-right: 0.95rem;
    opacity: 0.7;
  }

  /* If motion is reduced, the GSAP loop never starts — the static band
     still reads fine because the first few phrases are visible. */
</style>
