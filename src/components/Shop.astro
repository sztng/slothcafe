---
import { site } from '../data/site.js';
import { getProducts } from '../lib/shopify.js';
import Newsletter from './Newsletter.astro';

const products = await getProducts(3);
const { shop } = site;
---

<section class="shop" id="menu">
  <div class="container">
    <h2 class="shop__title" data-reveal="scroll">{shop.headline}</h2>

    <div class="products" data-reveal="scroll">
      {
        products.map((product) => {
          const variant = product.variants.nodes[0];
          return (
            <article class="product">
              <img
                src={product.featuredImage.url}
                alt={product.featuredImage.altText}
                class="product__img"
              />
              <h3 class="product__name">{product.title}</h3>
              <p class="product__notes">tasting notes: {product.description}</p>
              {variant && (
                <p class="product__price">
                  {variant.price.currencyCode} {variant.price.amount}
                </p>
              )}
              {variant?.availableForSale ? (
                <button
                  type="button"
                  class="product__add"
                  data-add-to-cart
                  data-variant-id={variant.id}
                  data-title={product.title}
                  data-price-amount={variant.price.amount}
                  data-price-currency={variant.price.currencyCode}
                  data-image={product.featuredImage.url}
                >
                  Add to cart
                </button>
              ) : (
                <span class="product__soldout">Sold out</span>
              )}
            </article>
          );
        })
      }
    </div>

    <a href={shop.shopAllHref} class="shop__link" data-reveal="scroll">{shop.shopAllLabel}</a>
  </div>

  <Newsletter />
</section>

<script>
  import { addToCart } from '../lib/cart.js';

  document.querySelectorAll('[data-add-to-cart]').forEach((btn) => {
    btn.addEventListener('click', () => {
      addToCart({
        variantId: btn.dataset.variantId,
        title: btn.dataset.title,
        priceAmount: btn.dataset.priceAmount,
        priceCurrency: btn.dataset.priceCurrency,
        image: btn.dataset.image,
        quantity: 1,
      });
    });
  });
</script>

<style>
  .shop {
    padding-top: 3rem;
    padding-bottom: var(--section-pad);
  }

  .shop__title {
    font-family: var(--font-body);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-align: center;
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin: 0 0 3rem;
  }

  .products {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
    margin-bottom: 2.5rem;
  }

  .product {
    text-align: center;
  }

  .product__img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: contain;
    margin-bottom: 1.25rem;
  }

  .product__name {
    font-family: var(--font-body);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-size: 1.05rem;
    margin: 0 0 0.5rem;
  }

  .product__notes {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: rgba(0, 0, 0, 0.65);
    margin: 0 0 0.75rem;
  }

  .product__price {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.9rem;
    margin: 0 0 0.75rem;
  }

  .product__add {
    display: inline-block;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    font-family: var(--font-mono);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.8rem;
    color: #000;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .product__add:hover {
    color: var(--teal-deep);
  }

  .product__soldout {
    display: inline-block;
    font-family: var(--font-mono);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.8rem;
    color: rgba(0, 0, 0, 0.4);
  }

  .shop__link {
    display: block;
    text-align: center;
    font-family: var(--font-mono);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-size: 0.85rem;
    color: #000;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .shop__link:hover {
    color: var(--teal-deep);
  }

  @media (max-width: 700px) {
    .products {
      grid-template-columns: 1fr;
    }
  }
</style>
