---
import { site } from '../data/site.js';
import { getProducts } from '../lib/shopify.js';

const products = await getProducts(3);
const { shop, newsletter } = site;
---

<section class="shop" id="menu">
  <div class="container">
    <h2 class="shop__title" data-reveal="scroll">{shop.headline}</h2>

    <div class="products" data-reveal="scroll">
      {
        products.map((product) => (
          <article class="product">
            <img
              src={product.featuredImage.url}
              alt={product.featuredImage.altText}
              class="product__img"
            />
            <h3 class="product__name">{product.title}</h3>
            <p class="product__notes">tasting notes: {product.description}</p>
          </article>
        ))
      }
    </div>

    <a href={shop.shopAllHref} class="shop__link" data-reveal="scroll">{shop.shopAllLabel}</a>
  </div>

  <div class="newsletter">
    <div class="container newsletter__inner" data-reveal="scroll">
      <div>
        <h3 class="newsletter__title">{newsletter.headline}</h3>
        <p class="newsletter__sub">{newsletter.sub}</p>
      </div>

      <form class="newsletter__form" onsubmit="event.preventDefault()">
        <input
          type="email"
          required
          placeholder={newsletter.placeholder}
          aria-label={newsletter.placeholder}
          class="newsletter__input"
        />
        <button type="submit" class="newsletter__btn">{newsletter.cta}</button>
      </form>
    </div>
  </div>
</section>

<style>
  .shop {
    padding-top: 3rem;
    padding-bottom: var(--section-pad);
  }

  .shop__title {
    font-family: var(--font-body);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-align: center;
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin: 0 0 3rem;
  }

  .products {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
    margin-bottom: 2.5rem;
  }

  .product {
    text-align: center;
  }

  .product__img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: var(--radius-card);
    margin-bottom: 1.25rem;
  }

  .product__name {
    font-family: var(--font-body);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-size: 1.05rem;
    margin: 0 0 0.5rem;
  }

  .product__notes {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: rgba(20, 51, 45, 0.65);
    margin: 0;
  }

  .shop__link {
    display: block;
    text-align: center;
    font-family: var(--font-mono);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    font-size: 0.85rem;
    color: var(--teal);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .shop__link:hover {
    color: var(--teal-deep);
  }

  .newsletter {
    margin-top: var(--section-pad);
  }

  .newsletter__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
  }

  .newsletter__title {
    font-family: var(--font-body);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    font-size: 1.3rem;
    margin: 0 0 0.75rem;
  }

  .newsletter__sub {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: rgba(20, 51, 45, 0.7);
    max-width: 34ch;
    margin: 0;
  }

  .newsletter__form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: min(320px, 100%);
  }

  .newsletter__input {
    font-family: var(--font-mono);
    text-transform: uppercase;
    font-size: 0.85rem;
    padding: 0.9em 1.1em;
    border: 1px solid rgba(20, 51, 45, 0.15);
    border-radius: 8px;
    background: var(--white);
    color: var(--ink);
  }

  .newsletter__input::placeholder {
    color: rgba(20, 51, 45, 0.4);
  }

  .newsletter__btn {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 700;
    font-size: 0.85rem;
    padding: 0.9em 1.1em;
    border: none;
    border-radius: 8px;
    background: var(--mint);
    color: var(--ink);
    cursor: pointer;
    transition: background-color 160ms ease;
  }

  .newsletter__btn:hover {
    background: var(--teal);
    color: var(--white);
  }

  @media (max-width: 700px) {
    .products {
      grid-template-columns: 1fr;
    }

    .newsletter__inner {
      align-items: flex-start;
    }
  }
</style>
