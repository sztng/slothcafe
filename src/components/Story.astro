---
import { site } from '../data/site.js';
const { story } = site;

/** Parse "100%" / "12" / "0" into a number + suffix for the count-up. */
function splitStat(value) {
  const match = value.match(/^(\d+)(.*)$/);
  return match ? { n: Number(match[1]), suffix: match[2] } : null;
}
---

<section
  class="story"
  id="story"
  aria-label="Our story, with a photo of the Sloth and Messenger barista at the counter"
>
  <div class="container story__copy" data-reveal="scroll">
    <p class="eyebrow">{story.eyebrow}</p>
    <h2 class="story__title">
      <span>{story.headline[0]}</span>
      <span class="story__title-italic">{story.headline[1]}</span>
    </h2>
    {story.paragraphs.map((text) => <p class="story__para">{text}</p>)}

    <hr class="story__rule" />

    <dl class="stats">
      {
        story.stats.map((stat) => {
          const parsed = splitStat(stat.value);
          return (
            <div class="stats__item">
              <dt class="stats__label">{stat.label}</dt>
              <dd
                class="stats__value"
                data-count={parsed?.n}
                data-count-suffix={parsed?.suffix}
              >
                {stat.value}
              </dd>
            </div>
          );
        })
      }
    </dl>
  </div>
</section>

<style>
  .story {
    position: relative;
    color: #fff;
    background:
      linear-gradient(rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0.55)),
      url('/images/sloth2026.jpg');
    background-size: cover;
    background-position: center 30%;
    padding-block: clamp(4rem, 9vw, 7rem);
  }

  .story .eyebrow {
    color: #fff;
  }

  .story__copy {
    max-width: 60rem;
  }

  .story__title {
    font-size: clamp(2.2rem, 4.5vw, 3.4rem);
    font-weight: 700;
    margin-bottom: 1.75rem;
  }

  .story__title span {
    display: block;
  }

  .story__title-italic {
    font-style: italic;
    font-weight: 500;
  }

  .story__para {
    margin: 0 0 1.25rem;
    color: rgba(255, 255, 255, 0.85);
  }

  .story__rule {
    border: none;
    border-top: 1px solid rgba(255, 255, 255, 0.25);
    margin: 2.25rem 0;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin: 0;
  }

  .stats__item {
    display: flex;
    flex-direction: column-reverse; /* value above label, valid dt/dd order */
  }

  .stats__value {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 2rem;
    color: #fff;
    margin: 0;
  }

  .stats__label {
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.95rem;
  }
</style>
